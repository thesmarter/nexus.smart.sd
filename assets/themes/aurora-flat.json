{
  "name": "Aurora Flat",
  "description": "A warm, earthy flat palette inspired by sunrise over the desert — paper canvas, vermilion action, jade accents, and mustard highlights.",
  "version": "1.0.0",
  "paradigm": "flat",
  "colors": {
    "background": "#F7F4EE",
    "foreground": "#3A342C",
