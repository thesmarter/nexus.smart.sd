    "popover": "#FBF8F2",
    "popover-foreground": "#3A342C",
    "bg-page": "#F7F4EE",
    "bg-sidebar": "#EFE8DC",
    "surface-1": "#FBF8F2",
    "surface-2": "#EFE8DC",
    "border-strong": "#D8CDB8",
    "accent-blue": "#E4572E",
    "accent-green": "#0F7B6C",
    "accent-red": "#C93A2B",
