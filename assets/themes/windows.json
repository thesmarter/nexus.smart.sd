{
  "name": "Windows",
  "description": "Native Windows 11 Fluent 2 look — Segoe UI Variable typography, acrylic surfaces, elevation shadows and a 4px corner radius.",
  "version": "1.0.0",
  "paradigm": "windows",
  "colors": {
    "background": "#F0F0F0",
    "foreground": "#3A3A3A",
    "primary": "#0078D4",
    "primary-foreground": "#FFFFFF",
    "secondary": "#0F7B0F",
    "secondary-foreground": "#FFFFFF",
    "muted": "#F2F2F2",
    "muted-foreground": "#616161",
    "accent": "#0078D4",
    "accent-foreground": "#FFFFFF",
    "destructive": "#C42B1C",
    "destructive-foreground": "#FFFFFF",
    "border": "#E7E7E7",
    "input": "#D9D9D9",
    "ring": "#0078D4",
    "card": "#FCFCFC",
    "card-foreground": "#3A3A3A",
    "popover": "#FCFCFC",
    "popover-foreground": "#3A3A3A",
    "bg-page": "#F0F0F0",
    "bg-sidebar": "#E9E9E9",
    "surface-1": "#FCFCFC",
    "surface-2": "#EFEFEF",
    "border-strong": "#C9C9C9",
    "accent-blue": "#0078D4",
    "accent-green": "#0F7B0F",
    "accent-red": "#C42B1C",
    "accent-amber": "#9D5D00"
  },
  "colorsDark": {
    "background": "#202020",
    "foreground": "#F3F3F3",
    "primary": "#4CC2FF",
    "primary-foreground": "#111111",
    "secondary": "#6CCB5F",
    "secondary-foreground": "#111111",
    "muted": "#323232",
    "muted-foreground": "#9E9E9E",
    "accent": "#4CC2FF",
    "accent-foreground": "#111111",
    "destructive": "#F1707A",
    "destructive-foreground": "#111111",
    "border": "#3D3D3D",
    "input": "#4A4A4A",
    "ring": "#4CC2FF",
    "card": "#2B2B2B",
    "card-foreground": "#F3F3F3",
    "popover": "#2B2B2B",
    "popover-foreground": "#F3F3F3",
    "bg-page": "#202020",
    "bg-sidebar": "#262626",
    "surface-1": "#2B2B2B",
    "surface-2": "#323232",
    "border-strong": "#4A4A4A",
    "accent-blue": "#4CC2FF",
    "accent-green": "#6CCB5F",
    "accent-red": "#F1707A",
    "accent-amber": "#FCE100"
  },
  "typography": {
    "family": "'Segoe UI Variable Text', 'Segoe UI', 'Segoe UI Emoji', system-ui, sans-serif",
    "heading": {
      "weight": 600,
      "letterSpacing": "0",
      "transform": "none"
    },
    "label": {
      "weight": 600,
      "letterSpacing": "0",
      "transform": "none"
    },
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    }
  },
  "effects": {
    "radius": "0.25rem",
    "radiusLg": "0.375rem",
    "radiusMd": "0.25rem",
    "radiusSm": "0.125rem",
    "borderWidth": "1px",
    "shadow": "material",
    "glassEffect": {
      "enabled": true,
      "blur": "24px",
      "opacity": "0.7"
    },
    "hoverScale": "1.01",
    "cardHoverScale": "1.002",
    "transition": "all 0.12s ease-out"
  },
  "layout": {
    "sidebar": {
      "position": "left",
      "width": "15rem",
      "collapsedWidth": "4.5rem"
    },
    "header": {
      "position": "fixed",
      "height": "3rem",
      "borderBottom": true
    },
    "content": {
      "maxWidth": "none",
      "padding": "1.25rem"
    },
    "shell": {
      "backgroundDecoration": true,
      "glassPanels": true
    }
  }
}
